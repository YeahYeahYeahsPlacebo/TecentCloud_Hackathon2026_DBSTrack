# Parser and Validator must use different models (CONTEXT.md constraint 4).
# The two model labels must differ.
# The two AppKeys must also differ (they identify separate ADP applications).
# Do not commit real values — leave .env for secrets.
PARSER_APPKEY=
VALIDATOR_APPKEY=
PARSER_MODEL_LABEL=
VALIDATOR_MODEL_LABEL=
ADP_ENDPOINT=
ADP_TIMEOUT_SECONDS=
